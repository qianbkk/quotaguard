# ============================================================
#  QuotaGuard .env template
#  Copy this file to `.env` and fill in your real key.
#  `.env` is gitignored — never commit it.
# ============================================================

# MiniMax subscription key (format: sk-cp-...)
MINIMAX_API_KEY=sk-cp-your-key-here

# Optional: override the default state file location
# QUOTAGUARD_STATE=~/.quotaguard/quota_state.json
# QUOTAGUARD_PAUSE=~/.quotaguard/PAUSE.flag
